# ==============================================================================
# VARIABLES DE ENTORNO — FINTECH (PRODUCCIÓN & LOCAL)
# ==============================================================================

# Opción A: Variables individuales de MySQL (XAMPP, WAMP, MySQL Workbench o VPS)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASSWORD=tu_contrasena_mysql
DB_NAME=prestamos_db
DB_SSL=false

# Opción B: Cadena única de conexión URI (Vercel Storage, TiDB Cloud, Railway, PlanetScale, Aiven)
# DATABASE_URL=mysql://usuario:password@host.cloud.com:3306/prestamos_db?ssl={"rejectUnauthorized":true}

# Clave secreta para generación y verificación de tokens JWT (Administrador)
# Generar una cadena aleatoria y segura en producción
JWT_SECRET=super_secure_jwt_secret_fintech_prestamos_2026_colombia_x99!

# Configuración Pública de la Aplicación
NEXT_PUBLIC_APP_NAME="FINTECH"
NEXT_PUBLIC_CURRENCY="COP"
